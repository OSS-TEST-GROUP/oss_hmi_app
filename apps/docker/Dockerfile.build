# adsw_monitor x86_64 Linux 빌드 환경
#
# 이 이미지는 Flutter 앱을 x86_64 Linux (GTK) 릴리스 번들로 빌드합니다.
#
# 빌드 (apps/ 디렉토리에서 실행):
#   docker build \
#     -f docker/Dockerfile.build \
#     -t adsw_monitor_builder:x86_64 .
#
# 실행:
#   docker run --rm \
#     -v $(pwd)/adsw_monitor:/workspace/app \
#     -v $(pwd)/output:/workspace/output \
#     adsw_monitor_builder:x86_64 \
#     --app-path=/workspace/app \
#     --output-dir=/workspace/output
# 결과물: output/adsw_monitor-x86_64-release.tar.gz

FROM ubuntu:22.04

ARG FLUTTER_VERSION=3.41.8

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_ROOT=/opt/flutter
ENV PATH="${FLUTTER_ROOT}/bin:${PATH}"

# 시스템 의존성 설치 (Flutter Linux 빌드 필수)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    file \
    git \
    python3 \
    unzip \
    wget \
    xz-utils \
    zip \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libstdc++-12-dev \
    && rm -rf /var/lib/apt/lists/*

# Flutter SDK 설치
#
# The container is run with an arbitrary --user (host UID/GID) so every
# path Flutter touches at runtime (its own cache under FLUTTER_ROOT,
# PUB_CACHE, HOME) must be writable by any UID. `chmod -R go+rwX` keeps
# existing executable bits intact while opening write access.
RUN git clone --depth 1 \
      --branch ${FLUTTER_VERSION} \
      https://github.com/flutter/flutter.git \
      ${FLUTTER_ROOT} && \
    flutter config --no-analytics && \
    flutter precache --linux && \
    flutter doctor -v && \
    chmod -R go+rwX ${FLUTTER_ROOT}

# 엔트리포인트 설치
COPY docker/build-entrypoint.sh /usr/local/bin/build-entrypoint.sh
RUN chmod +x /usr/local/bin/build-entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/build-entrypoint.sh"]
