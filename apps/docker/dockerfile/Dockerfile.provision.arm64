# =============================================================================
# provision 변형 — hmi_launcher 만 담고 앱 플러그인 매니페스트를 넣지 않는다.
#
# hmi_launcher 는 HMI_APPS_ROOT(/apps) 를 스캔해 <app>/manifest.json 이 있는 앱만
# 앱 그리드에 노출한다. 매니페스트를 넣지 않으면 그리드가 비고, 런처에 내장된
# Settings(상단바) 만 남는다 — 보드 최초 프로비저닝/설정 용도.
#
# 원본: Dockerfile.arm64 (매니페스트 COPY 블록만 제거, 그 외 동일)
# =============================================================================
# AGL aarch64 runtime image (adsw_monitor by default).
#
# An arm64 container that runs the app via flutter-auto on AGL.
# Build with buildx on x86_64, or natively on an arm64 host.
#
# Prereq:
#   The AOT build artifact must already exist under output/.
#   docker run adsw_monitor_builder ... --output-dir ./output
#
# Image build (run from the apps/ directory):
#   # Cross-build from x86_64 (buildx required)
#   docker buildx build --platform linux/arm64 \
#     -f docker/Dockerfile.arm64 \
#     -t adsw_monitor:arm64 .
#
#   # Native build on an arm64 host
#   docker build -f docker/Dockerfile.arm64 -t adsw_monitor:arm64 .
#
# Run (AGL target):
#   docker run --rm \
#     -v /run/user/1001:/run/user/1001 \
#     -v /usr/bin/flutter-auto:/usr/bin/flutter-auto \
#     -e WAYLAND_DISPLAY=wayland-0 \
#     -e XDG_RUNTIME_DIR=/run/user/1001 \
#     --network host \
#     --device /dev/dri \
#     adsw_monitor:arm64

# ── docker CLI (static binary, aarch64) ────────────────────────────────────
# rviz2_panel (running inside this image) directly controls the host rviz2
# container via the docker CLI.  We download only the static `docker` binary
# from the official download site; no daemon, no docker-compose.
# The docker.sock is bind-mounted at runtime by adsw_manager/agl-service-list.
#
# To update: change DOCKER_CLI_VERSION and rebuild.
FROM --platform=linux/arm64 ubuntu:24.04 AS docker-cli-fetch
ARG DOCKER_CLI_VERSION=27.5.1
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL \
      "https://download.docker.com/linux/static/stable/aarch64/docker-${DOCKER_CLI_VERSION}.tgz" \
      -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz --strip-components=1 -C /usr/local/bin docker/docker \
    && rm /tmp/docker.tgz \
    && chmod +x /usr/local/bin/docker
# grpcurl — agl-shell gRPC(:14005) 로 자기 서페이스를 풀화면·활성화한다(agl-run.sh).
# agl-compositor 는 클라이언트의 set_fullscreen(flutter-auto -f)을 무시하므로 이 경로가
# 유일하다. rviz2 이미지가 homebar/cage 활성화에 쓰는 것과 같은 정적 바이너리.
ARG GRPCURL_VERSION=1.9.1
RUN curl -fsSL \
      "https://github.com/fullstorydev/grpcurl/releases/download/v${GRPCURL_VERSION}/grpcurl_${GRPCURL_VERSION}_linux_arm64.tar.gz" \
      -o /tmp/grpcurl.tgz \
    && tar -xzf /tmp/grpcurl.tgz -C /usr/local/bin grpcurl \
    && rm /tmp/grpcurl.tgz \
    && chmod +x /usr/local/bin/grpcurl
# ── end docker CLI stage ────────────────────────────────────────────────────

FROM --platform=linux/arm64 ubuntu:24.04

ARG APP_NAME=adsw_monitor
ARG APP_VERSION=3.32.2
ARG CONFIG_FILE=config.json

ENV DEBIAN_FRONTEND=noninteractive
ENV APP_NAME=${APP_NAME}
ENV APP_VERSION=${APP_VERSION}
ENV CONFIG_FILE=${CONFIG_FILE}
ENV BUNDLE_PATH=/usr/share/flutter/${APP_NAME}/${APP_VERSION}/release
ENV XDG_RUNTIME_DIR=/run/user/1001
ENV HMI_APPS_ROOT=/apps

# Install AGL flutter-auto runtime dependencies.
# (GTK not needed — flutter-auto is Wayland/EGL based.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-cursor0 \
    libxkbcommon0 \
    libegl1 \
    libgl1 \
    libgles2 \
    libdrm2 \
    libgbm1 \
    libinput10 \
    libfontconfig1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libharfbuzz0b \
    libglib2.0-0 \
    libdbus-1-3 \
    # flutter-auto(AGL) 가 링크하는 런타임 (ldd 로 확인된 누락분)
    libc++1 \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libsecret-1-0 \
    fonts-noto \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Add the AOT artifact (tar.gz is auto-extracted).
# output/<APP_NAME>-release.tar.gz layout:
#   usr/share/flutter/{app_name}/{version}/release/
#     data/flutter_assets/
#     lib/libapp.so
#     lib/libflutter_engine.so
ADD output/${APP_NAME}-arm64-release.tar.gz /

# Bake the app config into the image (can be overridden at runtime via
# volume). CONFIG_FILE defaults to config.json for adsw / ota; hmi_launcher
# passes launcher_config.json via the --build-arg.
COPY ${APP_NAME}/config/${CONFIG_FILE} ${BUNDLE_PATH}/data/flutter_assets/assets/config/${CONFIG_FILE}

# Plugin manifests: hmi_launcher scans HMI_APPS_ROOT for <app>/manifest.json.
RUN mkdir -p /apps   # provision: 앱 매니페스트 없음 (Settings 전용)

# flutter-auto entrypoint script.
# The flutter-auto binary is expected to be mounted from the host, or it
# can be COPYed at image build time.
COPY docker/script/agl-run.sh /usr/local/bin/agl-run.sh
RUN chmod +x /usr/local/bin/agl-run.sh

# Copy the static docker CLI from the fetch stage.
# The binary is used by rviz2_panel to control the host rviz2 container.
# docker.sock must be bind-mounted at runtime: -v /var/run/docker.sock:/var/run/docker.sock
COPY --from=docker-cli-fetch /usr/local/bin/docker /usr/local/bin/docker

# agl-shell 활성화용(agl-run.sh 가 호출). 호스트의 agl-shell-activator 는
# libprotobuf/absl 에 링크돼 컨테이너에 마운트할 수 없어 정적 grpcurl 을 쓴다.
COPY --from=docker-cli-fetch /usr/local/bin/grpcurl /usr/local/bin/grpcurl

ENTRYPOINT ["/usr/local/bin/agl-run.sh"]
