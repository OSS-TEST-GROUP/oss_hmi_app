# arm64 test runtime image (for QEMU emulation; adsw_monitor by default).
#
# Runs the app via QEMU arm64 emulation on an x86_64 host.
# flutter-auto and libflutter_engine.so are pulled from output/agl-binaries/.
# (Extract them beforehand via scripts/extract-agl-binaries.sh or by
# docker run --entrypoint bash.) A headless Weston compositor is embedded.
#
# Prereqs:
#   output/agl-binaries/bin/flutter-auto
#   output/agl-binaries/flutter/3.32.2/release/lib/libflutter_engine.so
#   output/agl-binaries/flutter/3.32.2/release/data/icudtl.dat
#   output/adsw_monitor-arm64-release.tar.gz
#
# Build image (run from apps/):
#   docker build --platform linux/arm64 \
#     -f docker/Dockerfile.arm64.test \
#     -t adsw_monitor:arm64-test .
#
# Run:
#   docker run --rm --platform linux/arm64 \
#     --name adsw_monitor_arm64_test \
#     adsw_monitor:arm64-test
#
# config.json volume mount:
#   -v $(pwd)/adsw_monitor/config/config.json:\
#      /usr/share/flutter/adsw_monitor/3.32.2/release/data/flutter_assets/assets/config/config.json

FROM --platform=linux/arm64 ubuntu:24.04

ARG APP_NAME=adsw_monitor
ARG APP_VERSION=3.32.2
ARG CONFIG_FILE=config.json

ENV DEBIAN_FRONTEND=noninteractive
ENV APP_NAME=${APP_NAME}
ENV APP_VERSION=${APP_VERSION}
ENV CONFIG_FILE=${CONFIG_FILE}
ENV BUNDLE_PATH=/usr/share/flutter/${APP_NAME}/${APP_VERSION}/release
ENV XDG_RUNTIME_DIR=/run/user/1001
ENV WAYLAND_DISPLAY=wayland-0
# hmi_launcher discovers plugins by scanning HMI_APPS_ROOT for manifest.json files.
ENV HMI_APPS_ROOT=/apps

# flutter-auto runtime deps + Weston headless compositor.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # flutter-auto dependencies
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libglib2.0-0 \
    libegl1 \
    libgles2 \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-cursor0 \
    libxkbcommon0 \
    libsecret-1-0 \
    libsystemd0 \
    # fonts
    libfontconfig1 \
    fonts-noto \
    # Weston Wayland compositor (supports both headless and X11 backends)
    weston \
    libgbm1 \
    libdrm2 \
    libinput10 \
    libx11-6 \
    libx11-xcb1 \
    # neatvnc PAM auth
    libpam-runtime \
    # Mesa DRI swrast driver: enables llvmpipe (LLVM JIT rasterizer, ~10x faster
    # than softpipe) for both flutter-auto EGL rendering and Weston GL compositor.
    libgl1-mesa-dri \
    # misc
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Weston VNC backend PAM bypass (fixes libpam hang under QEMU arm64).
# Weston dlopens libpam.so.0, so we replace the library itself with a bypass stub
# that exports LIBPAM_1.0 versioned symbols and returns PAM_SUCCESS immediately.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpam0g-dev \
    && printf 'LIBPAM_1.0 {\n  global:\n    pam_start; pam_authenticate;\n    pam_acct_mgmt; pam_end;\n    pam_get_item; pam_set_item;\n  local: *;\n};\n' \
      > /tmp/pam.map \
    && printf '#include <security/pam_appl.h>\n#include <stdio.h>\n\
static void dbg(const char *msg) { FILE*f=fopen("/tmp/pam_debug.log","a"); if(f){fputs(msg,f);fclose(f);}}\n\
int pam_start(const char *s, const char *u, const struct pam_conv *c, pam_handle_t **h)\n\
  { dbg("pam_start\\n"); static int _d; *h=(pam_handle_t*)&_d; return PAM_SUCCESS; }\n\
int pam_authenticate(pam_handle_t *h, int f) { dbg("pam_authenticate\\n"); return PAM_SUCCESS; }\n\
int pam_acct_mgmt(pam_handle_t *h, int f)   { dbg("pam_acct_mgmt\\n"); return PAM_SUCCESS; }\n\
int pam_end(pam_handle_t *h, int s)         { dbg("pam_end\\n"); return PAM_SUCCESS; }\n\
int pam_get_item(const pam_handle_t *h, int t, const void **i) { if(i)*i=0; return PAM_SUCCESS; }\n\
int pam_set_item(pam_handle_t *h, int t, const void *i) { return PAM_SUCCESS; }\n' \
      > /tmp/pam_bypass.c \
    && gcc -shared -fPIC -Wl,--version-script=/tmp/pam.map \
         -o /tmp/pam_bypass.so /tmp/pam_bypass.c \
    && rm /tmp/pam_bypass.c /tmp/pam.map \
    && apt-get purge -y gcc libpam0g-dev && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && mv /usr/lib/aarch64-linux-gnu/libpam.so.0.85.1 /usr/lib/aarch64-linux-gnu/libpam.so.0.85.1.real \
    && cp /tmp/pam_bypass.so /usr/lib/aarch64-linux-gnu/libpam.so.0.85.1 \
    && rm /tmp/pam_bypass.so

# flutter-auto binary (pre-extracted from AGL SDK aarch64 sysroot).
COPY output/agl-binaries/bin/flutter-auto /usr/bin/flutter-auto
RUN chmod +x /usr/bin/flutter-auto

# AGL SDK libc++ (a newer version than Ubuntu 22.04 libc++1-14 is required).
COPY output/agl-binaries/lib/libc++.so.1.0 /usr/lib/aarch64-linux-gnu/libc++.so.1.0
COPY output/agl-binaries/lib/libc++abi.so.1.0 /usr/lib/aarch64-linux-gnu/libc++abi.so.1.0
RUN ln -sf libc++.so.1.0 /usr/lib/aarch64-linux-gnu/libc++.so.1 && \
    ln -sf libc++abi.so.1.0 /usr/lib/aarch64-linux-gnu/libc++abi.so.1

# Flutter engine libraries (release).
# App-bundle symlinks point at: /usr/share/flutter/3.32.2/release/
COPY output/agl-binaries/flutter/${APP_VERSION}/release/lib/ \
    /usr/share/flutter/${APP_VERSION}/release/lib/
COPY output/agl-binaries/flutter/${APP_VERSION}/release/data/ \
    /usr/share/flutter/${APP_VERSION}/release/data/

# AOT build artifact (tar.gz is auto-extracted).
# Layout: usr/share/flutter/<APP_NAME>/<APP_VERSION>/release/{data,lib}/
ADD output/${APP_NAME}-arm64-release.tar.gz /

# Config file — app lookup path: /etc/${APP_NAME}/${CONFIG_FILE}
# (can be overridden at runtime via volume mount). CONFIG_FILE defaults
# to config.json for adsw / ota; hmi_launcher passes launcher_config.json.
RUN mkdir -p /etc/${APP_NAME}
COPY ${APP_NAME}/config/${CONFIG_FILE} /etc/${APP_NAME}/${CONFIG_FILE}

# Plugin manifests: hmi_launcher scans HMI_APPS_ROOT for <app>/manifest.json.
# Bake them in so the launcher sidebar shows ota_monitor + adsw_monitor.
RUN mkdir -p /apps/ota_monitor /apps/adsw_monitor
COPY ota_monitor/manifest.json /apps/ota_monitor/manifest.json
COPY adsw_monitor/manifest.json /apps/adsw_monitor/manifest.json

# Weston headless + flutter-auto launcher script.
COPY docker/agl-run-test.sh /usr/local/bin/agl-run-test.sh
RUN chmod +x /usr/local/bin/agl-run-test.sh

ENTRYPOINT ["/usr/local/bin/agl-run-test.sh"]
