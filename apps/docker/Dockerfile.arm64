# adsw_monitor AGL aarch64 런타임 이미지
#
# AGL 환경에서 flutter-auto 로 앱을 실행하는 arm64 컨테이너입니다.
# x86_64 호스트에서 buildx 로 빌드하거나, arm64 호스트에서 직접 빌드합니다.
#
# 사전 조건:
#   AOT 빌드 결과물이 output/ 디렉토리에 있어야 합니다.
#   docker run adsw_monitor_builder ... --output-dir ./output
#
# 이미지 빌드 (apps/ 디렉토리에서 실행):
#   # x86_64 호스트에서 크로스빌드 (buildx 필요)
#   docker buildx build --platform linux/arm64 \
#     -f docker/Dockerfile.arm64 \
#     -t adsw_monitor:arm64 .
#
#   # arm64 호스트에서 직접 빌드
#   docker build -f docker/Dockerfile.arm64 -t adsw_monitor:arm64 .
#
# 실행 (AGL 타겟):
#   docker run --rm \
#     -v /run/user/1001:/run/user/1001 \
#     -v /usr/bin/flutter-auto:/usr/bin/flutter-auto \
#     -e WAYLAND_DISPLAY=wayland-0 \
#     -e XDG_RUNTIME_DIR=/run/user/1001 \
#     --network host \
#     --device /dev/dri \
#     adsw_monitor:arm64

FROM --platform=linux/arm64 ubuntu:22.04

ARG APP_NAME=adsw_monitor
ARG APP_VERSION=3.32.2

ENV DEBIAN_FRONTEND=noninteractive
ENV APP_NAME=${APP_NAME}
ENV APP_VERSION=${APP_VERSION}
ENV BUNDLE_PATH=/usr/share/flutter/${APP_NAME}/${APP_VERSION}/release
ENV XDG_RUNTIME_DIR=/run/user/1001

# AGL flutter-auto 런타임 의존성 설치
# (GTK 불필요 — flutter-auto 는 Wayland/EGL 기반)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-cursor0 \
    libxkbcommon0 \
    libegl1 \
    libgl1 \
    libgles2 \
    libdrm2 \
    libgbm1 \
    libinput10 \
    libfontconfig1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libharfbuzz0b \
    libglib2.0-0 \
    libdbus-1-3 \
    fonts-noto \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# AOT 빌드 결과물 추가 (tar.gz 자동 압축 해제)
# output/adsw_monitor-release.tar.gz 구조:
#   usr/share/flutter/{app_name}/{version}/release/
#     data/flutter_assets/
#     lib/libapp.so
#     lib/libflutter_engine.so
ADD output/${APP_NAME}-arm64-release.tar.gz /

# config.json 오버라이드 (빌드 시 포함, 런타임에서 볼륨으로 덮어쓸 수 있음)
COPY adsw_monitor/config/config.json ${BUNDLE_PATH}/data/flutter_assets/assets/config/config.json

# flutter-auto 엔트리포인트 스크립트
# flutter-auto 바이너리는 호스트에서 볼륨 마운트하거나
# 이미지 빌드 시 COPY로 포함할 수 있습니다.
COPY docker/agl-run.sh /usr/local/bin/agl-run.sh
RUN chmod +x /usr/local/bin/agl-run.sh

ENTRYPOINT ["/usr/local/bin/agl-run.sh"]
