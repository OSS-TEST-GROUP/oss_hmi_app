From 9a8c45f7b3d2e8c9e3f1a2b3c4d5e6f7a8b9c0d1 Mon Sep 17 00:00:00 2001
From: Developer Agent <claude@anthropic.com>
Date: Thu, 9 May 2026 06:00:00 +0900
Subject: [PATCH] R016: Use system OGRE 14.x instead of building 1.12.1

This patch replaces the build_ogre() macro call (which downloads and builds
OGRE 1.12.1 via ExternalProject_Add) with a simple find_package that uses
the system-installed OGRE 14.x (located in /opt/ogre from R005 build).

Rationale:
- OGRE 1.12.1 has no Wayland support (GLX only, X11-dependent)
- OGRE 14.x provides native Wayland+EGL backend (PR #3142)
- Building OGRE from source in colcon overlay is unnecessary duplication
- AGL Wayland compositor requires native Wayland rendering

This patch is AGL-specific and should NOT be upstreamed to ros2/rviz
(breaks normal ROS 2 Humble builds that rely on vendored OGRE 1.12.1).

Upstream-Status: Inappropriate [AGL-specific Wayland configuration]
Signed-off-by: Developer Agent <claude@anthropic.com>
---
 CMakeLists.txt | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a1b2c3d4..2e8f9a1b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -219,8 +219,18 @@ if(BUILDING_ZLIB_LOCALLY)
   build_zlib()
 endif()

-# Build OGRE
-build_ogre()
+# R016: Use system-installed OGRE 14.x instead of building 1.12.1
+# Rationale: OGRE 1.12.x has no Wayland support; 14.x provides native Wayland+EGL backend
+message(STATUS "[R016] Using system OGRE 14.x from /opt/ogre instead of building 1.12.1")
+
+# Find OGRE 14.x (installed by R005 in /opt/ogre)
+set(CMAKE_PREFIX_PATH "/opt/ogre;${CMAKE_PREFIX_PATH}")
+find_package(OGRE 14.5 REQUIRED COMPONENTS Main Overlay
+  HINTS /opt/ogre/lib/OGRE/cmake /opt/ogre/lib/cmake/OGRE
+)
+message(STATUS "[R016] Found OGRE ${OGRE_VERSION} at ${OGRE_CONFIG}")
+
+# Note: install() commands below will use system OGRE from /opt/ogre

 if(WIN32)
   ament_environment_hooks(env_hook/rviz_ogre_vendor_library_path.bat)
--
2.34.1


