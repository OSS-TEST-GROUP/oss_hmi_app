# rviz2-agl:autoware — Autoware(151) 시각화용 rviz2 변형
#
# 목적: 162 보드의 rviz2 가 151 의 Autoware ROS2 그래프를 크로스보드로 시각화한다.
#       Autoware 는 표준 rviz 타입이 아니라 autoware_*_msgs / tier4_*_msgs 로만 발행하므로
#       (실측: /perception/.../DetectedObjects, /planning/.../Trajectory, autoware_adapi_v1_msgs …)
#       vanilla rviz2 로는 아무것도 안 보인다. → autoware msgs + autoware rviz 플러그인 필요.
#       (RVIZ2_AUTOWARE_CONNECT.md §4)
#
# 전략: 터치 이미지(cage/wlroots/wayland + rviz2) 위에, Autoware 파티션 이미지가 이미
#       arm64 로 컴파일해 둔 /opt/autoware 오버레이(msgs 40 + rviz 플러그인 16, 550MB)를
#       그대로 COPY. 소스 빌드 불필요. 동일 ROS Humble arm64 → rviz_rendering/OGRE ABI 정합.
#
# autoware-overlay 이미지: junohb 6GB 전체를 162 로 옮기지 않기 위해, 151 에서
# /opt/autoware(550MB)만 담은 슬림 이미지를 미리 만들어 레지스트리에 올려둔다:
#   # (151 에서, 1회) junohb 의 /opt/autoware 만 추출 → 레지스트리 push
#   printf 'FROM junohb/autoware-partition:sample-adsw-perception AS s\nFROM scratch\nCOPY --from=s /opt/autoware /opt/autoware\n' \
#     | docker build -t registry.obigo.com/oss/autoware-overlay:latest -
#   docker push registry.obigo.com/oss/autoware-overlay:latest
#
# 태그 규약(RVIZ2_IMAGE_TAG_ALIGNMENT.md): 빌드 체인 :base(ros+rviz) → :touch(+cage) →
# :latest(+오버레이). FROM 은 :latest 를 참조하지 않는다(:latest 가 이 이미지라 재귀됨).
# 런타임 기본 = :latest, 불변 스냅샷 = <branch>-<date>-<shortsha> (OCI 라벨 5종 동반).
#
# 빌드/푸시(표준): apps/docker/script/build_rviz2_autoware.sh
#   → dirty 차단 + 스냅샷 태그 + OCI 라벨(--label) 을 자동 적용해 Orin(arm64)에서 네이티브
#     빌드 후 :latest + :<snap> push. (수동 docker build --label 도 가능하나 스크립트 권장)
#
# 실행: rviz2_monitor 가 -e ROS_DOMAIN_ID=<autoware 도메인> [-e RMW_IMPLEMENTATION=...]
#       -e RVIZ_CONFIG=/opt/autoware/share/autoware_launch/rviz/autoware.rviz 로 기동.
FROM registry.obigo.com/oss/rviz2-agl:touch AS autoware

USER root
ENV DEBIAN_FRONTEND=noninteractive

# CycloneDDS 설치. Autoware 가 cyclone 이면 rviz2 도 -e RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# 로 맞춘다(현행 Autoware=fastrtps 기본 → 미설정 시 자동 일치).
# ⚠️ base(agl-display/Dockerfile) 소스에도 cyclonedds+fastrtps 가 추가됐지만, 레지스트리의
#    :base/:touch 이미지는 그 변경 전에 빌드돼 cyclone 이 없다(실측 ABSENT). 그래서 여기서
#    설치가 여전히 필요하다. base+touch 를 재빌드하면 이 줄은 중복이 되어 제거 가능
#    (RVIZ2_IMAGE_TAG_ALIGNMENT.md §3).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# Autoware 오버레이(msgs + rviz 플러그인) — 파티션 이미지에서 컴파일된 arm64 산출물 복사.
# 슬림 오버레이 이미지(150→550MB)에서 복사해 162 로 6GB junohb 전체를 안 옮긴다.
# root:root world-readable 로 유지(rviz2 는 agl uid 로 read 만 필요 → chown 생략해 550MB
# 레이어 중복 방지).
COPY --from=registry.obigo.com/oss/autoware-overlay:latest /opt/autoware /opt/autoware

# autoware rviz 플러그인 + autoware 메시지의 런타임 의존은 /opt/autoware 밖(시스템/ROS)에
# 있어 오버레이 COPY 만으로는 누락된다(ldd + 런타임 확인). 채워 넣어 로드/subscribe 실패 방지:
#  - logging_demo typesupport → tier4_planning / state / planning_factor 플러그인(경로·궤적 등 핵심)
#  - lanelet2 스택(+geographiclib/pugixml/boost-serialization) → tier4_traffic_light 플러그인
#  - 표준 msg 패키지 → autoware_*_msgs 의 transitive 의존. 특히 geographic_msgs 누락 시
#    autoware_adapi_v1_msgs subscribe 가 "Type support not from this implementation" 로 실패해
#    autoware.rviz config 로드 자체가 중단됐다(런타임 확인). 구독 typesupport 확보용.
# (COPY 뒤 별도 레이어 → 550MB 오버레이 레이어 캐시 유지)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-logging-demo \
        ros-humble-lanelet2 \
        ros-humble-geographic-msgs \
        ros-humble-unique-identifier-msgs \
        ros-humble-pcl-msgs \
        ros-humble-radar-msgs \
        ros-humble-grid-map-msgs \
        ros-humble-velodyne-msgs \
        ros-humble-can-msgs \
        ros-humble-udp-msgs \
    && rm -rf /var/lib/apt/lists/*

# 갱신된 entrypoint: /opt/autoware/setup.bash 소스 + RVIZ_CONFIG(-d) 지원.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER agl
ENV PATH=/usr/local/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/lib/aarch64-linux-gnu:/usr/local/lib

# Provenance(OCI 라벨 5종 + com.obigo.*)는 빌드 스크립트가 `--label` 로 주입한다
# (RVIZ2_IMAGE_TAG_ALIGNMENT.md §1·§2 — Dockerfile ARG/LABEL 대신 래퍼 스크립트로 통일).
# 표준 빌드: apps/docker/script/build_rviz2_autoware.sh (스냅샷 태그+라벨+dirty 차단 자동).

# 터치 이미지와 동일 — cage 종료를 즉시 SIGKILL(자세한 이유는 Dockerfile.touch 참조).
STOPSIGNAL SIGKILL
ENTRYPOINT ["/entrypoint.sh"]
