<?xml version="1.0" encoding="UTF-8"?>
<protocol name="agl_shell">
  <copyright>
    Minimal subset of the AGL agl-shell protocol, sufficient for a secondary
    (doas) shell client that registers a persistent panel and activates apps.
    Request/event ordering (opcodes) matches the upstream agl-shell.xml so the
    wire protocol is compatible with the compositor. Reference:
    https://wayland.app/protocols/agl-shell
  </copyright>

  <interface name="agl_shell" version="2">
    <enum name="edge">
      <entry name="top" value="0"/>
      <entry name="bottom" value="1"/>
      <entry name="left" value="2"/>
      <entry name="right" value="3"/>
    </enum>

    <!-- opcode 0 -->
    <request name="ready"/>

    <!-- opcode 1 -->
    <request name="set_background">
      <arg name="surface" type="object" interface="wl_surface"/>
      <arg name="output" type="object" interface="wl_output"/>
    </request>

    <!-- opcode 2 -->
    <request name="set_panel">
      <arg name="surface" type="object" interface="wl_surface"/>
      <arg name="output" type="object" interface="wl_output"/>
      <arg name="edge" type="uint" enum="edge"/>
    </request>

    <!-- opcode 3 -->
    <request name="activate_app">
      <arg name="app_id" type="string"/>
      <arg name="output" type="object" interface="wl_output"/>
    </request>

    <!-- opcode 4 (since 2) -->
    <request name="destroy" type="destructor" since="2"/>

    <!-- event opcode 0 (since 2) -->
    <event name="bound_ok" since="2"/>
    <!-- event opcode 1 (since 2) -->
    <event name="bound_fail" since="2"/>
  </interface>

  <interface name="agl_shell_ext" version="1">
    <enum name="doas_shell_client_status">
      <entry name="success" value="0"/>
      <entry name="failed" value="1"/>
    </enum>

    <!-- opcode 0 -->
    <request name="destroy" type="destructor"/>

    <!-- opcode 1 -->
    <request name="doas_shell_client"/>

    <!-- event opcode 0 -->
    <event name="doas_done">
      <arg name="status" type="uint" enum="doas_shell_client_status"/>
    </event>
  </interface>
</protocol>
