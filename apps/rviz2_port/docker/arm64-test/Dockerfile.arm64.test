# R012: arm64 QEMU + Headless Weston Test Environment
# Template for x86_64 host testing of arm64 binaries via QEMU user emulation
# Pattern: oss_hmi_app Dockerfile.arm64.test (CI-friendly automated testing)

FROM --platform=linux/arm64 arm64v8/ubuntu:22.04 AS rviz-arm64-test

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

# Install QEMU user emulation support (will be provided by host binfmt_misc)
# Note: qemu-user-static is NOT installed in container (host manages binfmt)
# This is intentional - host setup via multiarch/qemu-user-static Docker image

# Install Weston compositor + headless backend
RUN apt-get update && apt-get install -y \
    weston \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-server0 \
    && rm -rf /var/lib/apt/lists/*

# Install VNC server for visual verification (optional)
RUN apt-get update && apt-get install -y \
    x11vnc \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Install RViz2 runtime dependencies (minimal set for template)
RUN apt-get update && apt-get install -y \
    libqt5waylandclient5 \
    qtwayland5 \
    libxkbcommon0 \
    libgles2-mesa \
    libdrm2 \
    && rm -rf /var/lib/apt/lists/*

# Install test utilities
RUN apt-get update && apt-get install -y \
    procps \
    psmisc \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Create runtime user (non-root for Wayland best practice)
RUN useradd -m -u 1000 -s /bin/bash agl

# Set up XDG runtime directory
RUN mkdir -p /run/user/1000 && chown agl:agl /run/user/1000 && chmod 700 /run/user/1000

# Weston configuration for headless backend + VNC
COPY weston-test.ini /home/agl/.config/weston.ini
RUN chown agl:agl /home/agl/.config/weston.ini

# R012 test entrypoint script
COPY entrypoint-arm64-test.sh /usr/local/bin/entrypoint-arm64-test.sh
RUN chmod +x /usr/local/bin/entrypoint-arm64-test.sh

# Placeholder RViz2 binary (R010 integration will replace this)
RUN echo '#!/bin/bash' > /usr/bin/rviz2 \
    && echo 'echo "[R012] Placeholder RViz2 (R010 binary integration pending)"' >> /usr/bin/rviz2 \
    && echo 'echo "[R012] Environment check:"' >> /usr/bin/rviz2 \
    && echo 'env | grep -E "WAYLAND|QT_QPA|XDG"' >> /usr/bin/rviz2 \
    && echo 'echo "[R012] Sleeping 35 seconds to simulate runtime..."' >> /usr/bin/rviz2 \
    && echo 'sleep 35' >> /usr/bin/rviz2 \
    && echo 'echo "[R012] Placeholder RViz2 exit (success)"' >> /usr/bin/rviz2 \
    && echo 'exit 0' >> /usr/bin/rviz2 \
    && chmod +x /usr/bin/rviz2

# Environment variables (aligned with R007 guards + R011 pattern)
ENV WAYLAND_DISPLAY=wayland-0
ENV XDG_RUNTIME_DIR=/run/user/1000
ENV QT_QPA_PLATFORM=wayland
ENV QT_WAYLAND_SHELL_INTEGRATION=xdg-shell
ENV APP_ID=org.agl.rviz2

# VNC port (optional, for visual verification)
ENV VNC_PORT=5900

# Weston backend selection (headless by default, can override to rdp)
ENV WESTON_BACKEND=headless

USER agl
WORKDIR /home/agl

ENTRYPOINT ["/usr/local/bin/entrypoint-arm64-test.sh"]
CMD ["rviz2"]
