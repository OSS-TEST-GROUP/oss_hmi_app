# RViz2 AGL aarch64 Cross-Compile Builder (Yocto Scarthgap + ROS2 Humble)
#
# R010 Session 1 (T1): Infrastructure setup only - NO actual bitbake build
# Actual build (T5-T8) deferred to next session (background task)
#
# This Dockerfile creates a Yocto bitbake environment to build RViz2 arm64
# against OGRE 14.5.2 from source, resolving R016 ABI mismatch.
#
# Build (from project root):
#   docker build \
#     -f docker/Dockerfile.build.arm64 \
#     -t rviz_agl:arm64-builder .
#
# Run (session 2):
#   docker run --rm -it \
#     -v $(pwd)/yocto:/workdir \
#     -v rviz-downloads:/workdir/downloads \
#     -v rviz-sstate:/workdir/sstate-cache \
#     rviz_agl:arm64-builder

# ===================================================================
# Stage 1: Yocto Host Dependencies (Scarthgap Requirements)
# ===================================================================

FROM ubuntu:22.04 AS yocto-deps

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Yocto Scarthgap host dependencies
# Reference: https://docs.yoctoproject.org/ref-manual/system-requirements.html
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Essential build tools
    gawk wget git diffstat unzip texinfo \
    gcc g++ gfortran build-essential chrpath socat cpio \
    python3 python3-pip python3-pexpect python3-git python3-jinja2 python3-subunit \
    xz-utils debianutils iputils-ping \
    # Additional Yocto requirements
    file lz4 zstd locales libacl1 \
    # Graphics/EGL dependencies (for target image, not host)
    libegl1-mesa libsdl1.2-dev mesa-common-dev \
    # Debugging tools (optional)
    pylint xterm \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Generate locale (required by bitbake)
RUN locale-gen en_US.UTF-8

# Create workspace directory
WORKDIR /workdir

# User UID/GID mapping for volume ownership (avoid permission issues)
# Usage: --build-arg USER_UID=$(id -u) --build-arg USER_GID=$(id -g)
ARG USER_UID=1000
ARG USER_GID=1000

RUN if [ ${USER_UID} -ne 0 ]; then \
        groupadd -g ${USER_GID} yocto || true; \
        useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash yocto || true; \
        chown -R ${USER_UID}:${USER_GID} /workdir; \
    fi

USER ${USER_UID}:${USER_GID}

# ===================================================================
# Stage 2: Yocto Layer Setup (Clone Preparation)
# ===================================================================

FROM yocto-deps AS yocto-builder

# Create sources directory structure
# Actual layer cloning done by host script (yocto-fetch-layers.sh)
# to avoid Docker build cache invalidation on layer updates
WORKDIR /workdir
RUN mkdir -p sources build/conf downloads sstate-cache

# Copy layer configuration samples (will be customized at runtime)
# Note: Actual conf files copied from host at runtime for flexibility
COPY --chown=${USER_UID}:${USER_GID} yocto/local.conf.arm64.sample /workdir/build/conf/local.conf.sample
COPY --chown=${USER_UID}:${USER_GID} yocto/bblayers.conf.arm64.sample /workdir/build/conf/bblayers.conf.sample

# Copy meta-rviz2-agl layer (our custom recipes)
COPY --chown=${USER_UID}:${USER_GID} yocto/meta-rviz2-agl /workdir/sources/meta-rviz2-agl

# Entrypoint placeholder (actual bitbake commands run manually in session 2)
# This session only validates Dockerfile syntax and structure
CMD ["/bin/bash", "-c", "echo 'R010 Session 1 complete: infrastructure ready. Run yocto-fetch-layers.sh on host, then start bitbake in session 2.'"]

# Labels for tracking
LABEL feature=R010 \
      session=1 \
      stage="infrastructure-setup" \
      arch="arm64-cross" \
      yocto-version="scarthgap-5.0" \
      ros-distro="humble" \
      ogre-version="14.5.2"
