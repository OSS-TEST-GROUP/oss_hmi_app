# Multi-arch arm64 runtime for RViz2 on AGL Trout 20.0.3 Wayland
# R011 narrowed: template only — actual rviz2 binary integration deferred to R010 external CI
#
# Build (from OSS harness root):
#   docker buildx build --platform=linux/arm64 \
#     -f docker/arm64-runtime/Dockerfile.arm64 \
#     -t rviz_agl:arm64-runtime-template \
#     docker/arm64-runtime/
#
# Run (on AGL target with Wayland compositor):
#   docker run --rm \
#     -v /run/user/1000:/run/user/1000 \
#     -e WAYLAND_DISPLAY=wayland-0 \
#     -e XDG_RUNTIME_DIR=/run/user/1000 \
#     --network host \
#     --device /dev/dri \
#     rviz_agl:arm64-runtime-template

ARG APP_VERSION=11.2.26
FROM --platform=linux/arm64 arm64v8/ubuntu:22.04 AS rviz-agl-arm64-runtime

ENV DEBIAN_FRONTEND=noninteractive

# Wayland runtime dependencies (minimal set for AGL Trout 20.0.3 compatibility)
# - libwayland-client0: Wayland client protocol library
# - libwayland-egl1: EGL integration for Wayland surfaces
# - libqt5waylandclient5 + qtwayland5: Qt5 Wayland QPA plugin (required by RViz2 Qt5 GUI)
# - libxkbcommon0: Keyboard input handling
# - libgles2-mesa: OpenGL ES 2.0 runtime (fallback for OGRE GLES2 render system)
# - libdrm2: Direct Rendering Manager (DRM) for GPU access
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwayland-client0 \
    libwayland-egl1 \
    libqt5waylandclient5 \
    qtwayland5 \
    libxkbcommon0 \
    libgles2-mesa \
    libdrm2 \
    && rm -rf /var/lib/apt/lists/*

# Placeholder rviz2 binary — replaced by R010 actual cross-compiled artifact
# External CI integration: Copy from R010 build stage
#   COPY --from=rviz-arm64-builder /workdir/yocto/build/tmp/deploy/rviz2 /usr/bin/rviz2
RUN echo '#!/bin/bash\n\
echo "[R011 PLACEHOLDER] rviz2 binary integration deferred to R010 external CI"\n\
echo "Environment check:"\n\
echo "  WAYLAND_DISPLAY=$WAYLAND_DISPLAY"\n\
echo "  QT_QPA_PLATFORM=$QT_QPA_PLATFORM"\n\
echo "  XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"\n\
echo "  APP_ID=$APP_ID"\n\
if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then\n\
    echo "  Wayland socket: ✓ present"\n\
else\n\
    echo "  Wayland socket: ✗ NOT found at $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"\n\
fi\n\
exit 0' > /usr/bin/rviz2 \
    && chmod +x /usr/bin/rviz2

# R007 entrypoint guard (xcb fallback prevention)
COPY agl-run.sh /usr/local/bin/agl-run.sh
RUN chmod +x /usr/local/bin/agl-run.sh

# Environment variables for AGL Wayland runtime (aligned with analysis doc Section 4.6)
ENV WAYLAND_DISPLAY=wayland-0
ENV XDG_RUNTIME_DIR=/run/user/1000
ENV QT_QPA_PLATFORM=wayland
ENV QT_WAYLAND_SHELL_INTEGRATION=xdg-shell
ENV APP_ID=org.agl.rviz2

ENTRYPOINT ["/usr/local/bin/agl-run.sh"]
CMD ["rviz2"]
