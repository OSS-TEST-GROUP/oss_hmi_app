import 'package:grpc/grpc.dart';
import '../src/generated/helloworld.pbgrpc.dart';

class GrpcClient {
  late final ClientChannel _channel;
  late final GreeterClient _stub;

  Future<void> init() async {
    _channel = ClientChannel(
      'localhost',
      port: 50051,
      options: const ChannelOptions(credentials: ChannelCredentials.insecure()),
    );
    _stub = GreeterClient(_channel);
  }

  Future<void> sendHello(String name) async {
    final request = HelloRequest()..name = name;
    final response = await _stub.sayHello(request);
    print('Response from server: ${response.message}');
  }

  Future<void> shutdown() async {
    await _channel.shutdown();
  }
}